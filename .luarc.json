{
    "runtime.version": "Lua 5.1",
    "runtime.path": [
        "?.lua",
        "?/init.lua"
    ],
    "diagnostics.globals": [
        "CreateFrame",
        "UIParent",
        "SlashCmdList",
        "SLASH_DECLARUS1"
    ],
    "workspace.checkThirdParty": false,
    "hint.enable": true,
    "completion.callSnippet": "Replace",
    "runtime.builtin": {
        "basic": "default",
        "coroutine": "default",
        "debug": "default",
        "io": "default",
        "math": "default",
        "os": "default",
        "package": "default",
        "string": "default",
        "table": "default",
        "utf8": "default"
    },
    "workspace.library": []
}
